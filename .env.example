# ==========================================
# Drug Information Q&A Agent - Configuration
# ==========================================

# Application Environment (development, production, testing)
APP_ENV=development
APP_NAME="Drug Information Q&A Agent"
API_PORT=8000
API_HOST=127.0.0.1

# LLM Configuration (Google Gemini)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings Engine
# "local" uses Sentence-Transformers (all-MiniLM-L6-v2) - offline, free, fast
# "gemini" uses Google Gemini text-embedding-004
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Database Paths
SQLITE_DB_PATH=./data/app.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads

# Security & Admin
# Passcode required for uploading new drug label PDFs
ADMIN_PASSCODE=admin123
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Medical Safety & RAG Thresholds
SIMILARITY_THRESHOLD=0.75
MAX_RETRIEVAL_CHUNKS=5
